
@{
    ViewData["Title"] = "Hasło zostało zmienione";
}

<div class="text-center mt-5">
    <h2>Hasło zostało pomyślnie zmienione!</h2>

    <p class="mt-3">
        Twoje hasło do konta OLYMPUS zostało zresetowane.
        Możesz teraz zalogować się przy użyciu nowego hasła.
    </p>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-primary mt-3">
        Przejdź do logowania
    </a>
</div>
