
@{
    ViewData["Title"] = "Odzyskiwanie hasła";
}

<div class="text-center mt-5">
    <h2>Sprawdź swoją skrzynkę e-mail</h2>

    <p class="mt-3">
        Jeśli podany adres e-mail jest przypisany do konta OLYMPUS,
        otrzymasz wiadomość z linkiem do zresetowania hasła.
    </p>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-primary mt-3">
        Wróć do logowania
    </a>
</div>
